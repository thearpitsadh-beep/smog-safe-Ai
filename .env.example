# GEMINI_API_KEY: Automatically injected by the AI Studio runtime for server-side Gemini AI.
# Do not commit secrets or expose keys in frontend code.
GEMINI_API_KEY=""

# GEMINI_MODEL: Optional override (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# VITE_GOOGLE_MAPS_API_KEY / GOOGLE_MAPS_API_KEY: Provisioned via AI Studio Google Maps setup.
VITE_GOOGLE_MAPS_API_KEY=""

# FORECAST_SIGNING_SECRET: Optional HMAC secret for signing server-fetched live forecasts.
# If omitted, a secure random per-process secret is generated at startup.
FORECAST_SIGNING_SECRET=""

# PORT: Server port (defaults to 3000).
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
